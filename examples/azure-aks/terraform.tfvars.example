# Cluster Configuration
cluster_name    = "sligo-production"
cluster_version = "1.28"
location        = "eastus"
# resource_group_name = ""  # Leave empty to auto-create

# Application Configuration
domain_name              = "app.example.com"
client_repository_name   = "your-client-containers"
app_version              = "v1.0.0"
chart_version            = "1.2.1"  # sligo-cloud Helm chart from sligo-helm-charts (independent of app_version)
# enable_control_plane_exporter = true  # Optional: GCS export (bucket sligo-tfstate-{client} from client_repository_name without -containers; prefix = basename of Terraform working directory)
# Optional: extra YAML merged into the sligo-cloud Helm release after module defaults (chart keys not exposed as module variables).
# helm_extra_values = <<-YAML
#   exampleSection:
#     enabled: true
# YAML
sligo_service_account_key_path = "./sligo-service-account-key.json"

# Database Configuration
db_username        = "sligo"
# db_password = "CHANGE_ME"
# Flexible Server SKU (B_Standard_B*, GP_Standard_D*), not a Compute VM size name.
postgres_sku_name  = "B_Standard_B1ms"
postgres_storage_mb = 32768

# Redis Configuration
# Optional: set redis_url (e.g. Redis Cloud rediss://...) to skip Azure Managed Redis.
# redis_url = ""  # GSM / secrets manager in production
redis_sku_name                  = "Balanced_B1"
redis_high_availability_enabled = true

# Required Secrets
jwt_secret          = "CHANGE_ME"
api_key             = "CHANGE_ME"
# Shared frontend↔backend service key (min 32 chars). Distinct from api_key.
backend_api_key     = "CHANGE_ME_MIN_32_CHARS________________"
nextauth_secret     = "CHANGE_ME"
gateway_secret      = "CHANGE_ME"
frontend_url        = "https://app.example.com"
next_public_api_url = "https://api.example.com"
encryption_key      = "CHANGE_ME"
# Optional: comma-separated allowlist for super-admin bootstrap
# super_admin_emails = "admin@example.com"
# auth_invitations   = "workos"

# Postmark email (optional)
# postmark_server_token = "CHANGE_ME"
# email_from = "noreply@mail.example.com"
# email_inbound_domain = "example.com"
# email_inbound_webhook_secret = "CHANGE_ME"
