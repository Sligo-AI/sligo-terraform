# Cluster Configuration
cluster_name    = "sligo-production"
gcp_project_id  = "your-project-id"
gcp_region      = "us-central1"
gcp_zones       = ["us-central1-a", "us-central1-b"]
cluster_version = "1.28"
# Teardown: set both false, run terraform apply, then terraform destroy
# gke_deletion_protection       = false
# cloud_sql_deletion_protection = false
# If destroy fails on service networking peering, increase wait (default 10m in module):
# private_service_access_destroy_wait = "15m"

# Application Configuration
domain_name              = "app.example.com"
client_repository_name   = "your-client-containers"
app_version              = "v1.0.0"  # Pin to specific version tag (e.g., v1.0.0, v1.2.3). Use 'latest' for development only.
chart_version            = "1.2.1"  # sligo-cloud Helm chart from sligo-helm-charts (independent of app_version)
# enable_control_plane_exporter = true  # Optional: GCS export (bucket sligo-tfstate-{client} from client_repository_name without -containers; prefix = basename of Terraform working directory)
# Optional: extra YAML merged into the sligo-cloud Helm release after module defaults (chart keys not exposed as module variables).
# helm_extra_values = <<-YAML
#   exampleSection:
#     enabled: true
# YAML
sligo_service_account_key_path = "./sligo-service-account-key.json"

# Database Configuration
db_tier = "db-f1-micro"
db_username = "sligo"
# db_password = "CHANGE_ME"  # Set via environment variable or secrets manager

# Redis Configuration
# Optional: set redis_url (e.g. Redis Cloud rediss://...) to skip in-cluster Redis Stack.
# redis_url = ""  # GSM / secrets manager in production
# redis_persistence_size          = "1Gi"
# redis_persistence_storage_class = "standard-rwo"

# GCS Storage Configuration (optional)
# gcs_bucket_name = "my-app-storage"  # Leave empty to auto-generate
# gcs_bucket_location = "US"
# gcs_bucket_versioning = true

# Secrets (use environment variables or secrets manager in production)
# jwt_secret = "CHANGE_ME"
# api_key = "CHANGE_ME"
# nextauth_secret = "CHANGE_ME"
# gateway_secret = "CHANGE_ME"
# frontend_url = "https://app.example.com"
# next_public_api_url = "https://api.example.com"

# Postmark email (optional)
# postmark_server_token = "CHANGE_ME"
# email_from = "noreply@mail.example.com"
# email_inbound_domain = "example.com"
# email_inbound_webhook_secret = "CHANGE_ME"
