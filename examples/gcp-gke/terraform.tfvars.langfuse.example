# Langfuse-enabled deployment (GCP GKE example)
# Merge these settings into terraform.tfvars / GSM JSON or export as TF_VAR_*.

# --- Self-hosted Langfuse (in-cluster; Super Admin embeds the UI) ---
enable_langfuse      = true
langfuse_self_hosted = true
langfuse_web_enabled = true
langfuse_db_name     = "langfuse"
# install_cert_manager         = true
# install_clickhouse_operator  = true
# langfuse_clickhouse_replicas = 1   # use 3 in production
# langfuse_keeper_replicas     = 1   # odd; use 3 in production

# Requires sligo-cloud Helm chart with sligo-langfuse-web:4.24.0 (base path compiled in).
# The UI is served at /super-admin/langfuse on the app domain. No Langfuse DNS name.
# chart_path = "../../path/to/sligo-cloud"  # local chart during development

# --- Langfuse Cloud / existing instance (no in-cluster Langfuse) ---
# enable_langfuse        = true
# langfuse_self_hosted   = false
# observability_provider = "langfuse"
# langfuse_base_url      = "https://cloud.langfuse.com"
# langfuse_public_key    = "pk-lf-..."
# langfuse_secret_key    = "sk-lf-..."
