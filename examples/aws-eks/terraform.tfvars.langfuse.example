# Langfuse-enabled deployment (AWS EKS example)
# Merge these settings into terraform.tfvars / GSM JSON or export as TF_VAR_*.

enable_langfuse      = true
langfuse_self_hosted = true
langfuse_web_enabled = true
langfuse_db_name     = "langfuse"

# Requires sligo-cloud Helm chart with sligo-langfuse-web:4.24.0 (base path compiled in).
# The UI is served at /super-admin/langfuse on the app domain. No Langfuse DNS name or ACM cert.

# --- Langfuse Cloud / existing instance ---
# enable_langfuse        = true
# langfuse_self_hosted   = false
# observability_provider = "langfuse"
# langfuse_base_url      = "https://cloud.langfuse.com"
# langfuse_public_key    = "pk-lf-..."
# langfuse_secret_key    = "sk-lf-..."
